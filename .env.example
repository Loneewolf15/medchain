# Copy this to .env and fill in as needed.

APP_NAME=MedChain
ENV=development

DATABASE_URL=sqlite:///./medchain.db

# --- THE FLAG ---
# hcs            -> audit trail on Hedera Consensus Service, access control in the DB
# smart_contract -> audit trail on HCS + access control enforced by AccessControl.sol on HSCS
LEDGER_MODE=hcs

# True = no real network calls, everything is faked in-memory (default, safe for dev/tests)
# False = real calls to Hedera testnet/mainnet using the credentials below
LEDGER_SIMULATE=true

# --- Only needed when LEDGER_SIMULATE=false ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RECORD_TOPIC_ID=
HEDERA_AUDIT_TOPIC_ID=
HEDERA_ACCESS_CONTRACT_ID=

JWT_SECRET=supersecret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000

IOT_SIMULATION_INTERVAL_SECONDS=10
